# Public Supabase credentials (safe for the browser).
# Copy this file to .env.local and fill in values from the project dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional. Used as the origin for auth email redirects (confirm signup).
# Also add {this origin}/auth/callback in the Supabase Auth redirect URL allowlist.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Do not prefix with NEXT_PUBLIC_. Leave unset unless a later
# phase needs a service-role client that Row Level Security cannot cover.
# SUPABASE_SERVICE_ROLE_KEY=
